# Copier en .env sur le serveur (jamais dans le repo).
# SMTP Gmail : SMTP_USER = ton adresse Gmail, SMTP_PASS = un mot de passe d'application
# (Compte Google → Sécurité → Validation en deux étapes → Mots de passe des applications).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Adresse qui reçoit les demandes (par défaut SMTP_USER).
CONTACT_TO=
MAIL_FROM_NAME="Site hugofeuilloy.fr"

# Origines autorisées à appeler l'endpoint, séparées par des virgules.
ALLOWED_ORIGINS=https://hugofeuilloy.fr,https://www.hugofeuilloy.fr
