diff --git a/api/src/mail-templates.php b/api/src/mail-templates.php
new file mode 100644
index 0000000..e56fedd
--- /dev/null
+++ b/api/src/mail-templates.php
@@ -0,0 +1,249 @@
+<?php
+
+declare(strict_types=1);
+
+/*
+ * Gabarits des e-mails envoyés par le formulaire de contact.
+ * HTML en tableaux et styles en ligne : c'est ce que les clients mail (Gmail, Outlook, Apple Mail) affichent correctement.
+ */
+
+const MAIL_INK = '#111113';
+const MAIL_MUTED = '#5E5A6E';
+const MAIL_SOFT = '#8A869A';
+const MAIL_VIOLET = '#6A48F2';
+const MAIL_VIOLET_TEXT = '#4B2FD6';
+const MAIL_BG = '#F4F3F8';
+const MAIL_LINE = '#E7E5EF';
+const MAIL_FONT = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
+
+function e(string $value): string
+{
+    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
+}
+
+function firstName(string $fullName): string
+{
+    $first = preg_split('/\s+/u', trim($fullName))[0] ?? '';
+    return mb_substr($first, 0, 40);
+}
+
+function mailButton(string $href, string $label, bool $primary = true): string
+{
+    $style = $primary
+        ? 'background:' . MAIL_VIOLET . ';color:#FFFFFF;border:1px solid ' . MAIL_VIOLET . ';'
+        : 'background:#FFFFFF;color:' . MAIL_INK . ';border:1px solid #D9D5E6;';
+    return '<a href="' . e($href) . '" style="' . $style . 'display:inline-block;padding:13px 22px;border-radius:10px;font-family:' . MAIL_FONT . ';font-size:15px;font-weight:600;line-height:20px;text-decoration:none;">' . e($label) . '</a>';
+}
+
+function mailLayout(string $title, string $preheader, string $content, string $footer): string
+{
+    $font = MAIL_FONT;
+    $bg = MAIL_BG;
+    $ink = MAIL_INK;
+    $line = MAIL_LINE;
+    $soft = MAIL_SOFT;
+    $violet = MAIL_VIOLET;
+
+    return <<<HTML
+<!doctype html>
+<html lang="fr">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="color-scheme" content="light">
+<meta name="supported-color-schemes" content="light">
+<title>{$title}</title>
+</head>
+<body style="margin:0;padding:0;background:{$bg};">
+<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:{$bg};">{$preheader}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
+<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{$bg};">
+  <tr>
+    <td align="center" style="padding:32px 16px;">
+      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
+        <tr>
+          <td style="padding:0 4px 20px;">
+            <table role="presentation" cellpadding="0" cellspacing="0">
+              <tr>
+                <td width="34" height="34" align="center" valign="middle" style="width:34px;height:34px;background:{$violet};border-radius:10px;font-family:{$font};font-size:13px;font-weight:700;color:#FFFFFF;letter-spacing:-0.3px;">HF</td>
+                <td style="padding-left:12px;font-family:{$font};font-size:15px;font-weight:600;color:{$ink};">Hugo Feuilloy</td>
+              </tr>
+            </table>
+          </td>
+        </tr>
+        <tr>
+          <td style="background:#FFFFFF;border:1px solid {$line};border-radius:16px;padding:32px 28px;font-family:{$font};color:{$ink};">
+{$content}
+          </td>
+        </tr>
+        <tr>
+          <td style="padding:20px 8px 0;font-family:{$font};font-size:12px;line-height:18px;color:{$soft};text-align:center;">{$footer}</td>
+        </tr>
+      </table>
+    </td>
+  </tr>
+</table>
+</body>
+</html>
+HTML;
+}
+
+/**
+ * E-mail reçu par Hugo à chaque demande.
+ *
+ * @param array<string, string> $f Champs nettoyés du formulaire
+ */
+function notificationHtml(array $f, string $receivedAt, string $siteHost): string
+{
+    $font = MAIL_FONT;
+    $name = e($f['nom']);
+    $first = e(firstName($f['nom']));
+
+    $chips = '';
+    foreach (array_filter(array_map('trim', explode(',', $f['besoins']))) as $need) {
+        $chips .= '<span style="display:inline-block;margin:0 6px 6px 0;padding:5px 11px;border-radius:999px;background:#F1EEFF;color:' . MAIL_VIOLET_TEXT . ';font-size:12px;font-weight:600;">' . e($need) . '</span>';
+    }
+    if ($f['budget'] !== '') {
+        $chips .= '<span style="display:inline-block;margin:0 6px 6px 0;padding:5px 11px;border-radius:999px;background:' . MAIL_BG . ';color:#3A3747;font-size:12px;font-weight:600;">Budget : ' . e($f['budget']) . '</span>';
+    }
+    $chipsRow = $chips !== '' ? '<p style="margin:16px 0 0;line-height:1;">' . $chips . '</p>' : '';
+
+    $company = $f['entreprise'] !== ''
+        ? '<p style="margin:4px 0 0;font-size:15px;line-height:22px;color:' . MAIL_MUTED . ';">' . e($f['entreprise']) . '</p>'
+        : '';
+
+    $message = nl2br(e($f['message']), false);
+
+    $rows = [['Email', '<a href="mailto:' . e($f['email']) . '" style="color:' . MAIL_VIOLET_TEXT . ';text-decoration:none;">' . e($f['email']) . '</a>']];
+    if ($f['telephone'] !== '') {
+        $rows[] = ['Téléphone', '<a href="tel:' . e(preg_replace('/[^\d+]/', '', $f['telephone'])) . '" style="color:' . MAIL_VIOLET_TEXT . ';text-decoration:none;">' . e($f['telephone']) . '</a>'];
+    }
+    if ($f['entreprise'] !== '') {
+        $rows[] = ['Entreprise', e($f['entreprise'])];
+    }
+    if ($f['budget'] !== '') {
+        $rows[] = ['Budget', e($f['budget'])];
+    }
+    $table = '';
+    foreach ($rows as [$label, $value]) {
+        $table .= '<tr><td width="110" style="padding:10px 0;border-top:1px solid ' . MAIL_LINE . ';font-size:13px;color:' . MAIL_SOFT . ';vertical-align:top;">' . $label . '</td><td style="padding:10px 0;border-top:1px solid ' . MAIL_LINE . ';font-size:14px;color:' . MAIL_INK . ';">' . $value . '</td></tr>';
+    }
+
+    $replyHref = 'mailto:' . $f['email'] . '?subject=' . rawurlencode('Votre projet web');
+    $buttons = mailButton($replyHref, 'Répondre à ' . firstName($f['nom']));
+    if ($f['telephone'] !== '') {
+        $buttons .= '&nbsp;&nbsp;' . mailButton('tel:' . preg_replace('/[^\d+]/', '', $f['telephone']), 'Appeler', false);
+    }
+
+    $violetText = MAIL_VIOLET_TEXT;
+    $content = <<<HTML
+            <p style="margin:0 0 10px;font-size:13px;font-weight:600;color:{$violetText};">Nouvelle demande</p>
+            <h1 style="margin:0;font-size:26px;line-height:30px;font-weight:700;letter-spacing:-0.5px;color:#111113;">{$name}</h1>
+            {$company}
+            {$chipsRow}
+            <div style="margin:22px 0 0;padding:18px 20px;background:#F8F7FB;border-radius:12px;font-size:15px;line-height:23px;color:#26232F;">{$message}</div>
+            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:22px;font-family:{$font};">{$table}</table>
+            <p style="margin:26px 0 0;">{$buttons}</p>
+HTML;
+
+    return mailLayout(
+        'Nouvelle demande – ' . $name,
+        e('Nouvelle demande de ' . $f['nom'] . ($f['besoins'] !== '' ? ' · ' . $f['besoins'] : '')),
+        $content,
+        'Reçu le ' . e($receivedAt) . ' via le formulaire de ' . e($siteHost) . '. Répondre à cet e-mail écrit directement à ' . $first . '.'
+    );
+}
+
+/** @param array<string, string> $f */
+function notificationText(array $f, string $receivedAt): string
+{
+    $lines = ['Nouvelle demande de ' . $f['nom'], ''];
+    $lines[] = $f['message'];
+    $lines[] = '';
+    $lines[] = '—';
+    foreach (['Email' => 'email', 'Téléphone' => 'telephone', 'Entreprise' => 'entreprise', 'Besoins' => 'besoins', 'Budget' => 'budget'] as $label => $key) {
+        if ($f[$key] !== '') {
+            $lines[] = "{$label} : {$f[$key]}";
+        }
+    }
+    $lines[] = '';
+    $lines[] = 'Reçu le ' . $receivedAt;
+    return implode("\n", $lines);
+}
+
+/**
+ * Accusé de réception envoyé au visiteur.
+ * Volontairement, il ne reprend jamais le message saisi : sinon le formulaire pourrait servir à envoyer
+ * du contenu arbitraire à n'importe quelle adresse depuis ta boîte Gmail.
+ *
+ * @param array{name: string, role: string, phone: string, email: string, site: string} $me
+ */
+function confirmationHtml(string $visitorName, array $me): string
+{
+    $first = firstName($visitorName);
+    $hello = $first !== '' ? 'Bien reçu, ' . e($first) . '&nbsp;!' : 'Bien reçu&nbsp;!';
+    $muted = MAIL_MUTED;
+    $line = MAIL_LINE;
+    $violet = MAIL_VIOLET_TEXT;
+    $siteHost = e(preg_replace('#^https?://#', '', $me['site']));
+    $myName = e($me['name']);
+    $myRole = e($me['role']);
+    $mySite = e($me['site']);
+
+    $steps = '';
+    foreach ([
+        ['01', 'On échange', 'Un appel ou une visio pour comprendre votre activité et vos objectifs.'],
+        ['02', 'Maquette et devis', 'Une direction visuelle et un devis détaillé, poste par poste.'],
+        ['03', 'Création', 'Je développe votre site, vous validez chaque étape importante.'],
+    ] as [$n, $title, $text]) {
+        $steps .= '<tr><td width="40" style="padding:14px 0;border-top:1px solid ' . $line . ';font-size:13px;font-weight:700;color:' . $violet . ';vertical-align:top;">' . $n . '</td><td style="padding:14px 0;border-top:1px solid ' . $line . ';"><span style="display:block;font-size:15px;font-weight:600;color:#111113;">' . $title . '</span><span style="display:block;margin-top:2px;font-size:14px;line-height:20px;color:' . $muted . ';">' . $text . '</span></td></tr>';
+    }
+
+    $phoneLine = $me['phone'] !== ''
+        ? '<a href="tel:' . e(preg_replace('/[^\d+]/', '', $me['phone'])) . '" style="color:#111113;text-decoration:none;">' . e($me['phone']) . '</a> &nbsp;·&nbsp; '
+        : '';
+
+    $content = <<<HTML
+            <h1 style="margin:0;font-size:24px;line-height:30px;font-weight:700;letter-spacing:-0.4px;color:#111113;">{$hello}</h1>
+            <p style="margin:12px 0 0;font-size:16px;line-height:24px;color:#26232F;">Merci pour votre message. Je l'ai bien reçu et je reviens vers vous <strong>sous 24&nbsp;h</strong> pour en discuter.</p>
+            <p style="margin:26px 0 4px;font-size:13px;font-weight:600;color:{$muted};">La suite</p>
+            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">{$steps}</table>
+            <p style="margin:22px 0 0;font-size:15px;line-height:23px;color:#26232F;">Une précision à ajouter&nbsp;? Répondez simplement à cet e-mail.</p>
+            <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:26px;border-top:1px solid {$line};width:100%;">
+              <tr><td style="padding-top:20px;">
+                <span style="display:block;font-size:15px;font-weight:700;color:#111113;">{$myName}</span>
+                <span style="display:block;margin-top:2px;font-size:13px;color:{$muted};">{$myRole}</span>
+                <span style="display:block;margin-top:8px;font-size:13px;color:#111113;">{$phoneLine}<a href="{$mySite}" style="color:{$violet};text-decoration:none;font-weight:600;">{$siteHost}</a></span>
+              </td></tr>
+            </table>
+HTML;
+
+    return mailLayout(
+        'Bien reçu – ' . e($me['name']),
+        'Je reviens vers vous sous 24 h pour discuter de votre projet.',
+        $content,
+        'Vous recevez ce message suite à une demande envoyée depuis ' . $siteHost . '. Si vous n\'êtes pas à l\'origine de cette demande, ignorez-le simplement.'
+    );
+}
+
+/** @param array{name: string, role: string, phone: string, email: string, site: string} $me */
+function confirmationText(string $visitorName, array $me): string
+{
+    $first = firstName($visitorName);
+    return implode("\n", [
+        $first !== '' ? "Bien reçu, {$first} !" : 'Bien reçu !',
+        '',
+        "Merci pour votre message. Je l'ai bien reçu et je reviens vers vous sous 24 h pour en discuter.",
+        '',
+        'La suite :',
+        '01 · On échange : un appel ou une visio pour comprendre votre activité et vos objectifs.',
+        '02 · Maquette et devis : une direction visuelle et un devis détaillé, poste par poste.',
+        '03 · Création : je développe votre site, vous validez chaque étape importante.',
+        '',
+        'Une précision à ajouter ? Répondez simplement à cet e-mail.',
+        '',
+        '—',
+        $me['name'],
+        $me['role'],
+        trim(($me['phone'] !== '' ? $me['phone'] . ' · ' : '') . $me['site']),
+    ]);
+}
